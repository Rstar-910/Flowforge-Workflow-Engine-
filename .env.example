# LOCAL DEVELOPMENT ONLY.
# Every credential in this file (the API keys and the database password "flowforge") is
# published in this public repository. They exist so the stack runs on your own machine
# with one copy command. The processes log a warning at startup when they see them.
# For anything reachable by other people, generate your own values; never commit them.
#
# Copy to .env and adjust.
FLOWFORGE_DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5433/flowforge
FLOWFORGE_SERVICE_NAME=flowforge
FLOWFORGE_LOG_LEVEL=INFO
FLOWFORGE_LOG_FORMAT=json

# API keys: comma separated "key:tenant:role". Roles: user | admin.
# The two keys below are public, local-development-only values.
FLOWFORGE_API_KEYS=dev-admin-key:default:admin,dev-user-key:default:user
FLOWFORGE_MAX_REQUEST_BYTES=1048576

# Comma separated Python modules that register task handlers (trusted code only).
FLOWFORGE_HANDLER_MODULES=flowforge.handlers.builtin

# Worker / lease tuning
FLOWFORGE_LEASE_SECONDS=15
FLOWFORGE_HEARTBEAT_INTERVAL_SECONDS=5
FLOWFORGE_WORKER_POLL_INTERVAL_SECONDS=0.5
FLOWFORGE_SCHEDULER_INTERVAL_SECONDS=1.0

# File standing in for an external system, used by the record_effect handler
# (examples/side-effect-workflow.json). All workers must see the same file.
FLOWFORGE_DEMO_LEDGER_PATH=.local-logs/ledger.jsonl

# Retention (applied by the scheduler). Unset = keep history forever.
# FLOWFORGE_EVENT_RETENTION_DAYS=14
# FLOWFORGE_RUN_RETENTION_DAYS=90      # also the idempotency-key window
FLOWFORGE_WORKER_RETENTION_HOURS=168
